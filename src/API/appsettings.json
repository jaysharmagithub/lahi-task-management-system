{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=db;Database=TaskManagementDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "CHANGE_ME_TO_A_32_CHAR_MIN_SECRET_KEY_IN_PRODUCTION",
    "Issuer": "TaskManagement",
    "Audience": "TaskManagement",
    "AccessTokenMinutes": "15",
    "RefreshTokenDays": "7",
    "RememberMeDays": "30"
  },
  "Email": {
    "Host": "smtp.example.com",
    "Port": "587",
    "Username": "your-smtp-user",
    "Password": "your-smtp-password",
    "From": "noreply@taskmanagement.com",
    "FromName": "Task Management"
  },
  "FileStorage": {
    "BasePath": "uploads"
  },
  "AllowedOrigins": [ "http://localhost:3000", "http://localhost:4200" ],
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "post:/api/v1/auth/login",
        "Period": "5m",
        "Limit": 10
      }
    ]
  },
  "AllowedHosts": "*"
}
